# Provider selection. PROVIDER_MODE is the default for all four providers.
# A non-empty per-provider value overrides it. Phase 1 runs in local mode.
PROVIDER_MODE=local
MAIL_PROVIDER=local
CALENDAR_PROVIDER=local
MODEL_PROVIDER=ollama

# Local model (Ollama). Starting values, tune on the MacBook Air M4 (16 GB).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TEMPERATURE=0
OLLAMA_MAX_RETRIES=2
OLLAMA_REQUEST_TIMEOUT_S=120
OLLAMA_WARMUP_ON_START=true

# Live model settings. Leave blank in Phase 1 (no Foundry or Azure OpenAI access yet).
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# Microsoft Graph. Leave blank in Phase 1 (no tenant access yet).
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=

# Storage and data. DATABASE_URL is proposed by Claude Code in Slice 1.
DATABASE_URL=
DATA_DIR=data/synthetic

# Simulated clock (fixed for the whole run).
SIMULATED_NOW=2026-10-16T10:00:00
SIMULATED_TZ=America/Chicago

# Application settings.
LOG_LEVEL=INFO
APPROVER_USER=local-user
API_PORT=8000
DASHBOARD_ORIGIN=http://localhost:5173
STALE_LEAD_DAYS=14